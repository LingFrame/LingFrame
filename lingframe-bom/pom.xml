<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.lingframe</groupId>
    <artifactId>lingframe-bom</artifactId>
    <packaging>pom</packaging>
    <version>${revision}</version>

    <name>LingFrame :: BOM</name>
    <description>LingFrame 版本清单</description>
    <url>https://github.com/LingFrame/LingFrame</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>LingFrame Team</name>
            <email>dev@lingframe.cn</email>
            <organization>LingFrame</organization>
            <organizationUrl>https://lingframe.cn</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/LingFrame/LingFrame.git</connection>
        <developerConnection>scm:git:ssh://github.com:LingFrame/LingFrame.git</developerConnection>
        <url>https://github.com/LingFrame/LingFrame</url>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/LingFrame/LingFrame/issues</url>
    </issueManagement>

    <distributionManagement>
        <repository>
            <id>central</id>
            <name>Central Portal</name>
            <url>https://central.sonatype.com</url>
        </repository>
    </distributionManagement>

    <properties>
        <revision>0.4.5</revision>
        <gpg.executable>gpg</gpg.executable>
    </properties>

    <!--
        BOM 仅暴露 LingFrame，不暴露第三方依赖
        外部项目如需要完整依赖管理，可 import lingframe-dependencies
    -->
    <dependencyManagement>
        <dependencies>
            <!-- 核心灵元 -->
            <dependency>
                <groupId>cn.lingframe</groupId>
                <artifactId>lingframe-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.lingframe</groupId>
                <artifactId>lingframe-api</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 运行时集成 -->
            <dependency>
                <groupId>cn.lingframe</groupId>
                <artifactId>lingframe-native</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.lingframe</groupId>
                <artifactId>lingframe-spring-boot-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.lingframe</groupId>
                <artifactId>lingframe-spring-boot2-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.lingframe</groupId>
                <artifactId>lingframe-spring-boot3-starter</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 基础设施层 -->
            <dependency>
                <groupId>cn.lingframe</groupId>
                <artifactId>lingframe-infra-storage</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.lingframe</groupId>
                <artifactId>lingframe-infra-cache</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 可视化治理中心 -->
            <dependency>
                <groupId>cn.lingframe</groupId>
                <artifactId>lingframe-dashboard</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.5.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.4</version>
                        <configuration>
                            <executable>${gpg.executable}</executable>
                            <keyname>${gpg.keyname}</keyname>
                            <passphrase>${gpg.passphrase}</passphrase>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
