<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.lingframe</groupId>
        <artifactId>lingframe-example-saas-mall</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>lingframe-example-saas-lingcore</artifactId>
    <packaging>jar</packaging>

    <name>LingFrame :: Example :: SaaS Mall LingCore</name>
    <description>SaaS商城灵核核心进程底座</description>

    <dependencies>
        <!-- 灵珑 Spring Boot 核心底座支持 -->
        <dependency>
            <groupId>com.lingframe</groupId>
            <artifactId>lingframe-spring-boot-starter</artifactId>
        </dependency>

        <!-- 本项目公共契约层 -->
        <dependency>
            <groupId>com.lingframe</groupId>
            <artifactId>lingframe-example-saas-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 复用大单体的底座数据结构及 Mapper 服务 (实现 100% 重用) -->
        <dependency>
            <groupId>com.lingframe</groupId>
            <artifactId>lingframe-example-ling-mall</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.lingframe</groupId>
            <artifactId>lingframe-example-saas-ling-oauth</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.lingframe</groupId>
            <artifactId>lingframe-example-saas-ling-seckill</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.lingframe</groupId>
            <artifactId>lingframe-example-saas-ling-refund</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>spring-boot2</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.lingframe</groupId>
                    <artifactId>lingframe-spring-boot2-starter</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.springdoc</groupId>
                    <artifactId>${springdoc.artifactId}</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
