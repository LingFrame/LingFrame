<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.lingframe</groupId>
        <artifactId>lingframe-examples</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>lingframe-example-lingcore-app</artifactId>
    <packaging>jar</packaging>

    <name>LingFrame :: Example :: LINGCORE App</name>
    <description>示例灵元核心应用</description>

    <properties>
        <lingframe.runE2E>false</lingframe.runE2E>
        <skipITs>true</skipITs>
    </properties>

    <dependencies>

        <dependency>
            <groupId>com.lingframe</groupId>
            <artifactId>lingframe-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>com.lingframe</groupId>
            <artifactId>lingframe-dashboard</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.lingframe</groupId>
            <artifactId>lingframe-example-ling-user</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.lingframe</groupId>
            <artifactId>lingframe-example-ling-user-canary</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.lingframe</groupId>
            <artifactId>lingframe-example-ling-order</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            仅打开 IT / E2E 开关，不绑定 Boot 运行时线。
            运行时线由 spring-boot2（默认）或 spring-boot3 选择。
            注意：只激活 integration-check 会停用 activeByDefault 的 spring-boot2，
            因此本地/CI 应始终写成 -Pspring-boot2,integration-check 或 -Pspring-boot3,integration-check。
        -->
        <profile>
            <id>integration-check</id>
            <properties>
                <lingframe.runE2E>true</lingframe.runE2E>
                <skipITs>false</skipITs>
            </properties>
        </profile>

        <profile>
            <id>spring-boot2</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.lingframe</groupId>
                    <artifactId>lingframe-spring-boot2-starter</artifactId>
                </dependency>
                <!-- SpringDoc for Boot 2 -->
                <dependency>
                    <groupId>org.springdoc</groupId>
                    <artifactId>${springdoc.artifactId}</artifactId>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>spring-boot3</id>
            <properties>
                <java.version>17</java.version>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>com.lingframe</groupId>
                    <artifactId>lingframe-spring-boot3-starter</artifactId>
                </dependency>
                <!-- SpringDoc for Boot 3：与 dependencies 父 POM SB3 profile 对齐 -->
                <dependency>
                    <groupId>org.springdoc</groupId>
                    <artifactId>${springdoc.artifactId}</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Compiler ling -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>UTF-8</encoding>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <excludes>
                        <exclude>**/ObservabilityClosedLoopIntegrationTest.java</exclude>
                        <exclude>**/DashboardUiSmokeIntegrationTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>add-it-test-source</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/it/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <skipITs>${skipITs}</skipITs>
                    <!-- 两个集成用例都会启动完整灵核，分开 fork 可以避免静态状态串扰。 -->
                    <forkCount>1</forkCount>
                    <reuseForks>false</reuseForks>
                    <systemPropertyVariables>
                        <lingframe.runE2E>${lingframe.runE2E}</lingframe.runE2E>
                    </systemPropertyVariables>
                    <includes>
                        <include>**/ObservabilityClosedLoopIntegrationTest.class</include>
                        <include>**/DashboardUiSmokeIntegrationTest.class</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>
